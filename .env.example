# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, configure this in Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE_PROJECT_ID: Optional override for Firebase ID token verification on Vercel.
# Defaults to projectId in firebase-applet-config.json when omitted.
FIREBASE_PROJECT_ID=

# ALLOWED_EMAILS: Optional comma-separated list of authorized Google account emails
# (e.g. "admin@aubergeramstein.fr,equipe@aubergeramstein.fr").
# Leave empty to allow any verified Google account signed in via Firebase Auth.
ALLOWED_EMAILS=
